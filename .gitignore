# Keep run inputs/outputs and scratch OUT of version control.
# The tutorial tells learners to keep working files in a private dir — this repo
# models that: never commit datasets, checkpoints, or job artifacts.
*.pdf
agent-labs/
outputs/
checkpoints/
*.pt
*.ckpt

# Slides: ship the built deck, nothing else. The LaTeX source, Makefile, and
# image assets live in the amsc_agentic_ai repo; here a clone gets a readable
# PDF without needing a TeX Live install. The negation re-includes the deck
# despite the blanket *.pdf above (last matching pattern wins).
slides/*
!slides/*.pdf

# Editor / OS cruft
.DS_Store
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# Local agent config that may hold identity/tokens (MAG PAT, IRI/Globus tokens)
.claude/settings.local.json
.env
