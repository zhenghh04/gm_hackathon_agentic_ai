// Author: Huihuo Zheng, huihuo.zheng@anl.gov
// Copyright: Trinity Science 2026
//
// opencode configuration for "Building Agentic Workflows with AmSC MAG and IRI"
// (Genesis Mission October Hackathon). This is the agent-agnostic twin of
// .mcp.json (Claude Code): it points opencode at the SAME four MCP servers AND
// at a model provider, so every lab runs identically under opencode.
//
// MAG is an OpenAI-compatible (LiteLLM) gateway. opencode must talk to it over
// the OpenAI wire with the trailing /v1 — the Anthropic wire returns a 302 that
// opencode does not follow, which surfaces as a silent "no response". Set your
// MAG Personal Access Token in the AMSC_I2_API_KEY environment variable (the same
// token Lab 01 uses for Claude Code), then run:  opencode
//
// MODEL IDS BELOW ARE A STARTING POINT, NOT A PROMISE. MAG's catalogue is its
// own and changes; a pinned ID it no longer serves fails as "model not found".
// Ask the gateway for the authoritative list and edit this block to match:
//   curl -H "Authorization: Bearer $AMSC_I2_API_KEY" \
//     https://mag.genesis.americansciencecloud.org/v1/models | jq '.data[].id'
{
  "$schema": "https://opencode.ai/config.json",

  // Model provider — AmSC MAG over the OpenAI-compatible wire.
  "provider": {
    "mag": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AmSC MAG",
      "options": {
        "baseURL": "https://mag.genesis.americansciencecloud.org/v1",
        "apiKey": "{env:AMSC_I2_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6 (via MAG)" },
        "claude-opus-4-6": { "name": "Claude Opus 4.6 (via MAG)" },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5 (via MAG)" }
      }
    }
  },

  // Pick the model opencode launches with (provider/model).
  "model": "mag/claude-sonnet-4-6",

  // The same four MCP servers Claude Code gets from .mcp.json.
  "mcp": {
    "alcf-iri": {
      "type": "local",
      "command": ["python", "mcp/hpc/alcf_server.py"],
      "enabled": true
    },
    "nersc-iri": {
      "type": "local",
      "command": ["python", "mcp/hpc/nersc_server.py"],
      "enabled": true
    },
    "olcf-iri": {
      "type": "local",
      "command": ["python", "mcp/hpc/olcf_iri_server.py"],
      "enabled": true
    },
    "knowledge": {
      "type": "local",
      "command": ["python", "mcp/knowledge/docs_server.py"],
      "enabled": true
    }
  },

  // Shared agent instructions — the same AGENTS.md Claude Code honors.
  "instructions": ["AGENTS.md"]
}
